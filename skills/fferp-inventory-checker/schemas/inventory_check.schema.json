{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["order_id", "status", "items", "requires_approval"],
  "properties": {
    "order_id": {"type": "string"},
    "status": {"enum": ["available", "insufficient", "needs_review"]},
    "items": {"type": "array", "items": {"type": "object"}},
    "reservation_proposal_file": {"type": ["string", "null"]},
    "requires_approval": {"type": "boolean"}
  }
}
